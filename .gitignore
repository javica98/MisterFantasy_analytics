# Entorno virtual y temporales
venv/
__pycache__/
*.pyc
.env
config/.env

# Datos crudos (no subir)
data/raw/
*.html
# La regla *.html de arriba también capturaba web/index.html por error —
# es el HTML de entrada de la web app, no un HTML crudo scrapeado, y nunca
# había estado en git (un clon nuevo del repo tenía la web rota, sin este
# archivo). Se excluye explícitamente de la regla genérica.
!web/index.html

# CSVs de temporada: la fuente de verdad es data/mister.db (SQLite,
# particionado por columna `temporada`). Los CSVs son ahora un artefacto
# local regenerable (ver scripts/export_db_to_csv.py para exportarlos a mano).
data/processed/
data/export/

# Config y logs locales
*.log

# IDE y herramientas locales
.vscode/
.claude/
.cache/

# Imágenes generadas (pesan demasiado para git)
newspaper/new/
newspaper/photos/Portada_Fichajes.jpg
newspaper/photos/Portada_Jornada.jpg

# Artefactos generados — reproducibles, no subir
newspaper/json/prompts/
newspaper/memory/
site/

# Temporadas archivadas: mismas reglas que las carpetas de trabajo
archive/*/newspaper/new/
archive/*/newspaper/json/prompts/
archive/*/newspaper/memory/

# Assets originales en alta resolución (pesan ~10MB, no necesarios para ejecutar)
assets/*.png
