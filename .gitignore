# Entorno virtual y temporales
venv/
__pycache__/
*.pyc
.env
config/.env

# Datos crudos (no subir)
data/raw/
*.html

# Config y logs locales
*.log

# IDE y herramientas locales
.vscode/
.claude/
.cache/

# Imágenes generadas (pesan demasiado para git)
newspaper/new/
newspaper/photos/Portada_Fichajes.jpg
newspaper/photos/Portada_Jornada.jpg

# Artefactos generados — reproducibles, no subir
newspaper/json/prompts/
newspaper/memory/
site/

# Temporadas archivadas: mismas reglas que las carpetas de trabajo
archive/*/newspaper/new/
archive/*/newspaper/json/prompts/
archive/*/newspaper/memory/

# Assets originales en alta resolución (pesan ~10MB, no necesarios para ejecutar)
assets/*.png
