# ──────────────────────────────────────────────────────────────
# MisterFantasy Analytics — Variables de entorno
# ──────────────────────────────────────────────────────────────
# 1. Copia este fichero: cp config/.env.example config/.env
# 2. Rellena los valores reales
# 3. NUNCA commites config/.env (está en .gitignore)
# ──────────────────────────────────────────────────────────────

# ── Credenciales de Mister Fantasy ────────────────────────────
# Usuario y contraseña de tu cuenta en mister.mundodeportivo.com
MISTER_USERNAME=tu_email@ejemplo.com
MISTER_PASSWORD=tu_contraseña

# URL base de la plataforma (no cambiar salvo migración)
MISTER_BASE_URL=https://mister.mundodeportivo.com

# ── APIs de LLM ───────────────────────────────────────────────
# Google Gemini — usado por OrchestratorAgent (Gemini 2.5 Flash-Lite),
# WriterAgent e ImageAgent (Gemini 2.5 Flash). ADR-006: todos los LLMs del
# proyecto usan tecnología de Google, aunque el proyecto no viva en su nube.
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── RAG — embeddings de memoria histórica (opcional) ───────────
# EmbeddingGemma (google/embeddinggemma-300m) requiere aceptar la licencia
# Gemma en Hugging Face y un token para la primera descarga (se cachea en
# disco después, igual que el modelo CLIP). Sin este token, el RAG cae
# automáticamente a búsqueda por palabras clave (ver src/memory/memory_store.py).
# Crear en: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLMOps — observabilidad de llamadas LLM (opcional) ─────────────────────────
# Registra cada llamada a Gemini/Groq en la tabla `llm_calls` del PostgreSQL
# de AI Center. Si no se configura, usa los valores por defecto del compose
# global (localhost:5432, DB/user/password "aicenter"). Si Postgres no está
# accesible, el logging se descarta silenciosamente (no rompe el pipeline).
# LLMOPS_ENABLED=true
# LLMOPS_PG_HOST=localhost
# LLMOPS_PG_PORT=5432
# LLMOPS_PG_DB=aicenter
# LLMOPS_PG_USER=aicenter
# LLMOPS_PG_PASSWORD=aicenter_secret
